[Unit]
Description=Real Estate Frontend (Next.js)
After=network.target real-estate-backend.service

[Service]
Type=simple
User=www-data
Group=www-data
WorkingDirectory=/var/www/real-estate/frontend
Environment=NODE_ENV=production
Environment=PORT=3000
ExecStart=/usr/bin/npm run start -- --hostname 127.0.0.1 --port 3000
Restart=always
RestartSec=5

[Install]
WantedBy=multi-user.target
